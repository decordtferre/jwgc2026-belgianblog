{% set grid_size = theme_var('grid-size') %}
{% set image = page.media.images|first %}

<section class="section modular-text {{ page.header.class}} py-3">
    <section class="container {{ grid_size }}">
        <div class="columns" style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;">
            
            {% if image %}
            <div class="column col-7 col-md-12" style="padding: 1rem;">
                <div class="text-content" style="padding-bottom: 0;">
                    {{ content|raw }}
                </div>
            </div>

            <div class="column col-5 col-md-12" style="position: relative; padding: 0;">
                <div class="image-wrapper" style="line-height: 0; width: 100%;">
                    {{ image.html('','','img-responsive', 'style="width: 100%; height: auto; display: block; margin: 0; position: absolute; bottom: 0; left: 0; right: 0; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.15);"')|raw }}
                </div>
            </div>
            {% else %}
            <div class="column col-12">
                {{ content|raw }}
            </div>
            {% endif %}
            
        </div>
    </section>
</section>

{% if page.header.show_sponsors %}
    {% include 'partials/sponsor-carousel.html.twig' %}
{% endif %}