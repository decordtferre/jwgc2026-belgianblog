{% extends 'partials/base.html.twig' %}

{% set header_image = page.header.header_image ? page.media.images[page.header.header_image] : page.media.images|first %}

{% block hero %}
    {% if header_image %}
        <section id="blog-hero" class="section hero" style="background-image: url('{{ header_image.url }}'); background-size: cover; background-position: center; height: 400px; display: flex; align-items: center; justify-content: center;">
            <div class="container grid-xl" style="text-align: center;">
                <h1 style="color: white; text-shadow: 2px 2px 10px rgba(0,0,0,0.7); font-size: 3.5rem;">{{ page.title }}</h1>
            </div>
        </section>
    {% endif %}
{% endblock %}

{% block body %}
    <section id="body-wrapper" class="section">
        <section class="container {{ grid_size }}">
            <div class="columns">
                <div class="column col-12">
                    {% block content %}
                        {{ page.content|raw }}
                    {% endblock %}
                </div>
            </div>
        </section>
    </section>
{% endblock %}