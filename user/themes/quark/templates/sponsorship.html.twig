{% extends 'partials/base.html.twig' %}

{% block content %}
<style>
    /* Algemene pagina styling */
    .sponsor-page { 
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
        color: #1a1a1a; 
        line-height: 1.5; 
        background: #fff; 
    }
    /* Padding-top verlaagd naar 10px voor minder witruimte onder de zwarte banner */
    .container-wide { max-width: 900px; margin: 0 auto; padding: 10px 20px 40px 20px; }
    
    /* Hero sectie bovenaan */
    .hero-alt { background: #ffffff; color: #fff; padding: 0px 20px; text-align: center; }
    .hero-alt h1 { color: #000000; font-size: 2.2rem; margin-bottom: 5px; text-transform: uppercase; font-weight: 800; letter-spacing: -1px; }
    .hero-alt p { font-size: 1.1rem; opacity: 0.8; margin: 0; }

    /* De introductie tekst - margin-top op 0 gezet */
    .intro-text { 
        font-size: 1.05rem; 
        text-align: left; 
        max-width: 750px; 
        margin: 0 auto 40px auto; 
        color: #333; 
    }
    .intro-text p { margin-bottom: 1.2rem; }

    /* De kaarten met voordelen */
    .grid-benefits { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .benefit-card { background: #fdfdfd; padding: 25px; border: 1px solid #eee; border-top: 3px solid #C8102E; border-radius: 4px; }
    .benefit-card h3 { margin-top: 0; color: #000; font-size: 1.15rem; margin-bottom: 5px; }
    .benefit-card p { font-size: 0.95rem; color: #555; margin: 0; line-height: 1.4; }

    /* De zwarte box met mogelijkheden */
    .offer-box { background: #ffffff; color: #000000; padding: 30px; border-radius: 8px; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px; }
    .offer-box h2 { color: #C8102E; grid-column: 1 / -1; margin-top: 0; font-size: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 20px; }
    .offer-box h4 { margin-top: 0; margin-bottom: 15px; color: #C8102E; text-transform: uppercase; letter-spacing: 0.5px; } 
    
    .offer-list { list-style: none; padding: 0; margin: 0; }
    .offer-list li { margin-bottom: 8px; font-size: 0.95rem; display: flex; align-items: flex-start; }
    .offer-list li::before { content: "✓"; color: #C8102E; font-weight: bold; margin-right: 12px; }

    /* Contact sectie */
    .cta-section { text-align: center; padding: 50px 20px; background: #f9f9f9; border-radius: 8px; }
    .btn-sponsor { background: #C8102E; color: #ffffff; padding: 14px 35px; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 1rem; display: inline-block; transition: 0.2s; margin-bottom: 30px; }
    .btn-sponsor:hover { background: #C8102E; transform: translateY(-2px); }

    /* Clickable contact links onderaan */
    .contact-links { 
        display: flex; 
        justify-content: center; 
        gap: 25px; 
        flex-wrap: wrap; 
        font-weight: bold; 
        font-size: 0.95rem;
    }
    .contact-links a, .contact-links span { 
        color: #1a1a1a; 
        text-decoration: none; 
        display: flex; 
        align-items: center; 
        gap: 8px; 
    }
    .contact-links a:hover { color: #005596; text-decoration: underline; }

    @media (max-width: 768px) {
        .offer-box { grid-template-columns: 1fr; gap: 20px; }
        .hero-alt h1 { font-size: 1.8rem; }
        .contact-links { flex-direction: column; gap: 10px; }
    }
</style>

<div class="sponsor-page">
    <header class="hero-alt">
        <h1>{{ page.title }}</h1>
    </header>

    <div class="container-wide">
        <div class="intro-text">
            {{ page.content|raw }}
        </div>

        <div class="grid-benefits">
            {% for benefit in page.header.benefits %}
            <div class="benefit-card">
                <h3>{{ benefit.title }}</h3>
                <p>{{ benefit.text }}</p>
            </div>
            {% endfor %}
        </div>

        <section class="offer-box">
            <h2>Sponsorship Opportunities</h2>
            <div>
                <h4>How you can help</h4>
                <ul class="offer-list">
                    {% for item in page.header.opportunities.help %}
                    <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </div>
            <div>
                <h4>What we offer</h4>
                <ul class="offer-list">
                    {% for item in page.header.opportunities.return %}
                    <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </div>
        </section>

       <section class="cta-section" style="
            text-align: center; 
            padding: 60px 20px; 
            background: #f9f9f9; 
            border-radius: 8px; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center;
        ">
            <h2 style="margin-top:0; margin-bottom: 15px; color: #9E1B32; width: 100%; text-align: center; font-weight: 800;">
                Ready to partner with us?
            </h2>
            
            <p style="margin-bottom: 30px; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center; color: #333; font-size: 1.1rem;">
                Let’s discuss how we can represent your brand on the world stage.
            </p>
            
            <a href="mailto:{{ page.header.contact_email }}" class="btn-sponsor" style="background-color: #9E1B32; margin-left: auto; margin-right: auto;">
                Contact the PR Team
            </a>
            
            <div class="contact-links" style="display: flex; justify-content: center; gap: 25px; flex-wrap: wrap; margin-top: 20px; width: 100%;">
                <span style="display: flex; align-items: center; gap: 8px;">📞 {{ page.header.phone }}</span>
                <a href="https://{{ page.header.website }}" target="_blank" style="display: flex; align-items: center; gap: 8px;">🌐 {{ page.header.website }}</a>
                <a href="mailto:{{ page.header.contact_email }}" style="display: flex; align-items: center; gap: 8px;">✉️ {{ page.header.contact_email }}</a>
            </div>
        </section>
    </div>
</div>
{% endblock %}