{% extends 'partials/base.html.twig' %}

{% block content %}
<style>
    /* Algemene pagina styling */
    .sponsor-page { 
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
        color: #1a1a1a; 
        line-height: 1.6; 
        background: #fff; 
    }

    /* Hero sectie met de zwever (breed en smal) */
    .hero-alt { 
        background: linear-gradient(to bottom, rgba(0,0,0,0.2) 60%, #fff 100%), 
                    url('{{ url("theme://images/IMG_2640.JPG") }}') no-repeat center bottom 40%; 
        background-size: cover;
        color: #fff;
        padding: 80px 20px;
        text-align: center;
        min-height: 350px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 50px;
    }
    
    .hero-alt h1 { 
        color: #ffffff; 
        font-size: 2.8rem; 
        margin: 0; 
        text-transform: uppercase; 
        font-weight: 800; 
        letter-spacing: -1px; 
        text-shadow: 2px 2px 15px rgba(0,0,0,0.6); 
    }

    /* Container voor de content */
    .container-wide { 
        max-width: 1000px; 
        margin: 0 auto; 
        padding: 40px 20px; 
    }
    
    /* Flexbox voor Intro tekst + Portrait foto */
    .intro-flex-container {
        display: flex;
        gap: 50px;
        align-items: flex-start;
        margin-bottom: 60px;
    }

    .intro-text { 
        flex: 1;
        font-size: 1.05rem; 
        text-align: left; 
        color: #333; 
    }
    .intro-text p { margin-bottom: 1.2rem; }

    .intro-image-wrapper {
        flex: 0 0 320px; /* Breedte van de portrait foto */
    }

    .intro-image-wrapper img {
    display: block; /* Zorgt dat ze onder elkaar staan als blokken */
    margin-bottom: 15px; /* Dit creëert het witte gat tussen de twee foto's */
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

    /* De laatste foto heeft geen witruimte onderaan nodig */
    .intro-image-wrapper img:last-child {
        margin-bottom: 0;
    }

    /* De kaarten met voordelen */
    .grid-benefits { 
        display: grid; 
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
        gap: 25px; 
        margin-bottom: 50px; 
    }
    .benefit-card { 
        background: #fdfdfd; 
        padding: 25px; 
        border: 1px solid #eee; 
        border-top: 4px solid #C8102E; 
        border-radius: 4px; 
    }
    .benefit-card h3 { margin-top: 0; color: #000; font-size: 1.2rem; margin-bottom: 10px; }
    .benefit-card p { font-size: 0.95rem; color: #555; margin: 0; }

    /* De witte box met mogelijkheden */
    .offer-box { 
        background: #ffffff; 
        color: #000000; 
        padding: 40px; 
        border: 1px solid #eee;
        border-radius: 8px; 
        display: grid; 
        grid-template-columns: 1fr 1fr; 
        gap: 40px; 
        margin-bottom: 50px; 
    }
    .offer-box h2 { 
        color: #C8102E; 
        grid-column: 1 / -1; 
        margin-top: 0; 
        font-size: 1.8rem; 
        border-bottom: 2px solid #f0f0f0; 
        padding-bottom: 15px; 
        margin-bottom: 20px; 
    }
    .offer-box h4 { margin-top: 0; margin-bottom: 15px; color: #C8102E; text-transform: uppercase; font-weight: 700; } 
    
    .offer-list { list-style: none; padding: 0; margin: 0; }
    .offer-list li { margin-bottom: 10px; font-size: 0.95rem; display: flex; align-items: flex-start; }
    .offer-list li::before { content: "✓"; color: #C8102E; font-weight: bold; margin-right: 12px; }

    /* Contact sectie */
    .cta-section { 
        text-align: center; 
        padding: 60px 20px; 
        background: #f9f9f9; 
        border-radius: 12px; 
    }
    .btn-sponsor { 
        background: #C8102E; 
        color: #ffffff; 
        padding: 16px 40px; 
        text-decoration: none; 
        border-radius: 4px; 
        font-weight: bold; 
        font-size: 1.1rem; 
        display: inline-block; 
        transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
        margin-bottom: 30px; 
    }
    .btn-sponsor:hover { background: #a60d26; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(200, 16, 46, 0.2); }

    .contact-links { 
        display: flex; 
        justify-content: center; 
        gap: 30px; 
        flex-wrap: wrap; 
        font-weight: 600; 
    }
    .contact-links a, .contact-links span { color: #1a1a1a; text-decoration: none; display: flex; align-items: center; gap: 8px; }
    .contact-links a:hover { color: #C8102E; text-decoration: underline; }

    /* Responsive aanpassingen */
    @media (max-width: 850px) {
        .intro-flex-container { flex-direction: column; text-align: center; }
        .intro-text { text-align: center; }
        .intro-image-wrapper { flex: none; width: 100%; max-width: 350px; margin: 0 auto; }
        .offer-box { grid-template-columns: 1fr; padding: 25px; }
        .hero-alt h1 { font-size: 2rem; }
        .contact-links { flex-direction: column; gap: 15px; }
    }
</style>

<div class="sponsor-page">
    <header class="hero-alt">
        <h1>{{ page.title }}</h1>
    </header>

    <div class="container-wide">
        <section class="intro-flex-container">
            <div class="intro-text">
                {{ page.content|raw }}
            </div>

            <div class="intro-image-wrapper">
                <img src="{{ url('user/themes/quark/images/IMG_2662.JPG') }}" alt="Cockpit view">
                <img src="{{ url('user/themes/quark/images/trailer.JPG') }}" alt="Glider trailers">
            </div>
        </section>

        <div class="grid-benefits">
            {% for benefit in page.header.benefits %}
            <div class="benefit-card">
                <h3>{{ benefit.title }}</h3>
                <p>{{ benefit.text }}</p>
            </div>
            {% endfor %}
        </div>

        <section class="offer-box">
            <h2>Sponsorship Opportunities</h2>
            <div>
                <h4>How you can help</h4>
                <ul class="offer-list">
                    {% for item in page.header.opportunities.help %}
                    <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </div>
            <div>
                <h4>What we offer</h4>
                <ul class="offer-list">
                    {% for item in page.header.opportunities.return %}
                    <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        <section class="cta-section">
            <h2 style="margin-top:0; margin-bottom: 15px; color: #C8102E; font-weight: 800; font-size: 2rem;">
                Ready to partner with us?
            </h2>
            
            <p style="margin: 0 auto 35px auto; color: #444; font-size: 1.1rem; text-align: center !important; display: block; width: 100%;">
                Let’s discuss how we can represent your brand on the world stage.
            </p>
            
            <a href="mailto:{{ page.header.contact_email }}" class="btn-sponsor">
                Contact the PR Team
            </a>
            
            <div class="contact-links">
                <span>📞 {{ page.header.phone }}</span>
                <a href="https://{{ page.header.website }}" target="_blank">🌐 {{ page.header.website }}</a>
                <a href="mailto:{{ page.header.contact_email }}">✉️ {{ page.header.contact_email }}</a>
            </div>
        </section>
    </div>
</div>
{% endblock %}