{% extends 'partials/base.html.twig' %}

{% block content %}
<section class="container grid-lg" style="padding-top: 0;">
    <div class="piloten-lijst">
        {{ page.content|raw }}

        {% for piloot in page.header.piloten %}
            {% set is_even = loop.index is even %}
            
            <div class="columns" style="display: flex; align-items: flex-start; margin-bottom: 4rem; flex-direction: {{ is_even ? 'row-reverse' : 'row' }};">
                
                {# Foto Kolom #}
                <div class="column col-5">
                    {% set image = page.media[piloot.foto] ?: page.media.images[piloot.foto] %}
                    
                    {% if image %}
                        <div class="img-container">
                            {{ image.html('', piloot.naam, 'img-responsive s-rounded shadow-lg')|raw }}
                        </div>
                    {% else %}
                        <div style="background: #f0f0f0; border: 1px dashed #ccc; padding: 20px; border-radius: 8px; text-align: center;">
                            <p style="color: #666; font-size: 0.9rem;">
                                <strong>{{ piloot.naam }}</strong><br>
                                Zoekt naar: <code>{{ piloot.foto }}</code><br>
                                <small>Kijkt in: <code>{{ page.relative_path }}</code></small>
                            </p>
                        </div>
                    {% endif %}
                </div>

                {# Tekst Kolom — altijd links uitgelijnd #}
                <div class="column col-7" style="text-align: left; padding: {{ is_even ? '0 2rem 0 0' : '0 0 0 2rem' }};">
                    <h2 style="margin-top: 0; font-weight: 800; color: #333;">{{ piloot.naam }}</h2>

                    {# Vlieginfo badges #}
                    <div class="piloot-meta">
                        {% if piloot.rol %}
                            {{ piloot.rol }}
                        {% else %}
                            ✈ {{ piloot.zweeftype }} | {{ piloot.immatriculatie }} | {{ piloot.competitienummer }}
                            {% endif %}
                    </div>

                    {# Beschrijving #}
                    <div style="font-size: 0.8rem; line-height: 1.6; color: #555; margin-top: 0.3rem;">
                        {{ piloot.tekst|markdown }}
                    </div>
                </div>

            </div>
        {% endfor %}
    </div>
</section>

<style>
    .img-responsive.s-rounded {
        transition: transform 0.3s ease;
    }
    .img-responsive.s-rounded:hover {
        transform: scale(1.02);
    }
    .shadow-lg {
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }

    /* Vlieginfo badges */
    .piloot-meta {
        display: inline-block;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 0.25rem 0.75rem;
        font-size: 0.85rem;
        color: #444;
        margin-top: 0.25rem;
        margin-bottom: 0.5rem;
}
    .meta-badge {
        display: inline-block;
        background: #f0f0f0;
        border: 1px solid #ddd;
        border-radius: 20px;
        padding: 0.2rem 0.75rem;
        font-size: 0.85rem;
        color: #444;
        font-weight: 500;
    }
</style>
{% endblock %}